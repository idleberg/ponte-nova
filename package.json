{
	"name": "ponte-nova",
	"version": "0.0.0",
	"description": "Bridging the gap between Node.js and Nova",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/ponte-nova.git"
	},
	"keywords": [
		"rollup-plugin",
		"nova",
		"nova-extension",
		"nodejs",
		"compatibility"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/plugin.d.mts",
			"import": "./dist/plugin.mjs"
		},
		"./crypto": {
			"types": "./dist/api/crypto.d.mts",
			"import": "./dist/api/crypto.mjs"
		},
		"./path": {
			"types": "./dist/api/path.d.mts",
			"import": "./dist/api/path.mjs"
		},
		"./fs": {
			"types": "./dist/api/fs.d.mts",
			"import": "./dist/api/fs.mjs"
		},
		"./fs/promises": {
			"types": "./dist/api/fs-promises.d.mts",
			"import": "./dist/api/fs-promises.mjs"
		},
		"./os": {
			"types": "./dist/api/os.d.mts",
			"import": "./dist/api/os.mjs"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze",
		"prepack": "npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np --any-branch",
		"test": "#vitest run"
	},
	"dependencies": {
		"@rollup/plugin-alias": "^6.0.0",
		"@rollup/plugin-commonjs": "^29.0.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"consola": "^3.4.2"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.4.1",
		"@commitlint/config-conventional": "^20.4.1",
		"@e18e/cli": "^0.3.1",
		"@idleberg/configs": "^0.4.2",
		"@types/node": "^24.10.0",
		"@types/nova-editor-node": "^5.1.5",
		"@vitest/coverage-v8": "^4.0.18",
		"concurrently": "^9.2.1",
		"np": "^11.0.2",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"rollup": "^2.0.0 || ^3.0.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"rollup": {
			"optional": true
		}
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"lefthook"
		]
	},
	"packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a"
}
