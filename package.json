{
	"name": "ponte-nova",
	"version": "0.0.0",
	"description": "Bridging the gap between Node.js and Nova",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/ponte-nova.git"
	},
	"keywords": [
		"rollup-plugin",
		"nova",
		"nova-extension",
		"nodejs",
		"compatibility"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/plugin.d.mts",
			"import": "./dist/plugin.mjs"
		},
		"./buffer": {
			"types": "./dist/api/buffer.d.mts",
			"import": "./dist/api/buffer.mjs"
		},
		"./child_process": {
			"types": "./dist/api/child_process.d.mts",
			"import": "./dist/api/child_process.mjs"
		},
		"./crypto": {
			"types": "./dist/api/crypto.d.mts",
			"import": "./dist/api/crypto.mjs"
		},
		"./path": {
			"types": "./dist/api/path.d.mts",
			"import": "./dist/api/path.mjs"
		},
		"./fs": {
			"types": "./dist/api/fs.d.mts",
			"import": "./dist/api/fs.mjs"
		},
		"./fs/promises": {
			"types": "./dist/api/fs-promises.d.mts",
			"import": "./dist/api/fs-promises.mjs"
		},
		"./os": {
			"types": "./dist/api/os.d.mts",
			"import": "./dist/api/os.mjs"
		},
		"./process": {
			"types": "./dist/api/process.d.mts",
			"import": "./dist/api/process.mjs"
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=20.19"
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze",
		"prepack": "npm run build",
		"publish:npm": "np --any-branch",
		"test": "#vitest run"
	},
	"dependencies": {
		"@rollup/plugin-alias": "^6.0.0",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-inject": "^5.0.5",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"consola": "^3.4.2",
		"hash-wasm": "^4.12.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@e18e/cli": "^0.7.0",
		"@idleberg/configs": "^0.4.6",
		"@types/node": "^26.4.1",
		"@types/nova-editor-node": "^5.1.7",
		"@vitest/coverage-v8": "^5.0.0",
		"concurrently": "^10.0.5",
		"np": "^12.1.0",
		"tsdown": "^0.23.0",
		"typescript": "^5.9.3",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"rollup": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"rollup": {
			"optional": true
		}
	},
	"packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
